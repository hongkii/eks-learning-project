configs:
  cm:
    admin.enabled: false
    url: ${argocd_url}
    # https://dexidp.io/docs/connectors/github/
    dex.config: |
      connectors:
        - type: github
          id: github
          name: GitHub
          config:
            clientID: ${client_id}
            clientSecret: $argocd-dex-github:clientSecret
  rbac:
    # No policy.default, so a user that is not listed gets no role.
    policy.csv: |
%{ for email in admin_emails ~}
      g, ${email}, role:admin
%{ endfor ~}
    scopes: "[groups, email]"

dex:
  enabled: true
