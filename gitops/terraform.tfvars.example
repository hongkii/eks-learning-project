# Copy to terraform.tfvars. *.tfvars is git-ignored.
repo_url             = "https://github.com/<owner>/argocd-capability-demo.git"
dex_github_client_id = "<GitHub OAuth App client ID>"
argocd_admin_emails  = ["you@example.com"]
slack_channel_id     = "C0123456789"

idc_user = {
  user_name   = "argocd-admin"
  email       = "you@example.com"
  given_name  = "Argo"
  family_name = "Admin"
}
