# Copy to terraform/terraform.tfvars. make setup does this automatically.

# General
# aws_region must be a region registered in the availability_zones map in vpc.tf.
aws_region  = "ap-northeast-1"
environment = "dev"

# EKS cluster
cluster_name = "my-study-eks"

# Standard support version. Extended support versions incur an additional charge.
# https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
kubernetes_version = "1.35"

# Node group version. Commented out means it follows kubernetes_version.
# Pin it to N-1 to upgrade the control plane first and keep a bake period.
# node_group_kubernetes_version = "1.35"

# Network
vpc_cidr = "10.0.0.0/16"

# A single NAT Gateway keeps the cost down. Set false for per-AZ fault isolation.
single_nat_gateway = true

# EC2 key pair for node SSH access. An empty string disables SSH.
ec2_key_pair_name = ""

# Node group
node_group_min_size     = 2
node_group_desired_size = 2
node_group_max_size     = 3
instance_types          = ["t3.small"]
disk_size               = 20
capacity_type           = "SPOT"

# Lower to 1 when pods do not need IMDS access.
imds_hop_limit = 2

# Cluster endpoint access
endpoint_private_access = true
endpoint_public_access  = true
public_access_cidrs     = ["0.0.0.0/0"]

# Logging. Enabling every type raises the CloudWatch ingestion cost.
enabled_cluster_log_types = ["api", "audit"]
log_retention_days        = 1
