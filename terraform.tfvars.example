# terraform/terraform.tfvars 로 복사해서 사용한다.
# make setup 이 자동으로 복사한다.

# 기본 설정
# aws_region 은 vpc.tf 의 availability_zones 맵에 등록된 리전만 사용 가능하다.
aws_region  = "ap-northeast-1"
environment = "dev"

# EKS 클러스터 설정
cluster_name = "my-study-eks"

# standard support 버전을 쓴다. extended support 버전은 추가 요금이 발생한다.
# https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
kubernetes_version = "1.34"

# 네트워크 설정
vpc_cidr = "10.0.0.0/16"

# NAT Gateway 를 1개만 생성해 비용을 절감한다. AZ 장애 격리가 필요하면 false.
single_nat_gateway = true

# SSH 접근용 EC2 키 페어 (빈 문자열이면 SSH 비활성화)
ec2_key_pair_name = ""

# 노드 그룹 설정
node_group_min_size     = 2
node_group_desired_size = 2
node_group_max_size     = 3
instance_types          = ["t3.small"]
disk_size               = 20
capacity_type           = "SPOT"

# 파드에서 IMDS 를 참조할 필요가 없으면 1 로 낮춘다.
imds_hop_limit = 2

# 클러스터 엔드포인트 접근
endpoint_private_access = true
endpoint_public_access  = true
public_access_cidrs     = ["0.0.0.0/0"]

# 로그. 전체 활성화는 CloudWatch 수집 비용이 커진다.
enabled_cluster_log_types = ["api", "audit"]
log_retention_days        = 1
